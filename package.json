{
  "name": "cipher-studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @cipher-studio/api run dev",
    "dev:web": "npm --workspace @cipher-studio/web run dev",
    "build": "npm run build --workspace @cipher-studio/api && npm run build --workspace @cipher-studio/web"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "devDependencies": { "concurrently": "^9.1.2", "typescript": "^5.7.3" }
}
